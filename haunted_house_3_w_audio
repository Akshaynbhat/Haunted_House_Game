void setMenuCamera() { px = 2.5f; py = 1.65f; pz = 14.2f; yaw = -8; pitch = 20; }

bool nearChapterPoint(float x, float z, float radius = 1.8f)
{
    float dx = px - x, dz = pz - z;
    return dx * dx + dz * dz <= radius * radius;
}

void interactChapter2()
{
    if (currentLevel < 2) return;

    if (nearChapterPoint(-7.0f, 1.5f) && !chapterPuzzle[0]) {
        if (!uvMode) setStatus("The Entrance Hall mirror is blank. Turn on UV mode (U) and inspect it.", 3.5f);
        else {
            chapterPuzzle[0] = true; lightning = 0.8f; sfx(S_CHIME, 0.7f);
            setStatus("ENTRANCE TRIAL SOLVED: A face appears behind the mirror.", 3.5f);
        }
        return;
    }
    if (nearChapterPoint(-7.0f, -5.0f) && !chapterPuzzle[1]) {
        if (!uvMode) setStatus("The Library books have spectral numbers. Activate UV (U), then press E to inspect.", 3.5f);
        else setStatus("UV ORDER REVEALED: Enter the book sequence 3 - 1 - 4 using number keys.", 4.0f);
        return;
    }
    if (nearChapterPoint(7.0f, -5.0f) && !chapterPuzzle[2]) {
        if (!lightActive() || battery < 10.0f) setStatus("The Dining Room's false objects hide in darkness. Keep the flashlight on.", 3.5f);
        else {
            chapterPuzzle[2] = true; battery = std::max(0.0f, battery - 7.0f); sfx(S_CHIME, 0.7f);
            setStatus("DINING TRIAL SOLVED: You chose the only object casting a shadow.", 3.5f);
        }
        return;
    }
    if (nearChapterPoint(-7.0f, -13.5f) && !chapterPuzzle[3]) {
        chapterPuzzle[3] = true; sfx(S_CHIME, 0.7f);
        setStatus("MEDICAL TRIAL: You pull the emergency fuse from the operating table.", 3.5f);
        return;
    }
    if (nearChapterPoint(7.0f, -13.5f) && !chapterPuzzle[4]) {
        if (!chapterPuzzle[3]) setStatus("The generator needs the medical-room fuse. Search the Medical Room first.", 3.5f);
        else {
            chapterPuzzle[4] = true; lightning = 1.0f; sfx(S_SLAM, 0.8f);
            battery = std::min(100.0f, battery + (currentLevel == 3 ? 5.0f : 10.0f));
            setStatus("BASEMENT TRIAL SOLVED: The generator starts... and wakes something.", 4.0f);
        }
        return;
    }
    if (nearChapterPoint(0.0f, -30.5f)) {
        if (corridorSigils < 3) setStatus("The altar rejects you. Three memory sigils are still missing.", 3.0f);
        else if (!(chapterPuzzle[0] && chapterPuzzle[1] && chapterPuzzle[2] && chapterPuzzle[3] && chapterPuzzle[4]))
            setStatus("The altar is sealed. Complete all five room trials first.", 3.0f);
        else {
            ritualReleased = true; lightning = 1.0f; sfx(S_BELL, 1.0f); sfx(S_MOAN, 0.9f);
            setStatus("THE RITUAL IS BROKEN. RUN TO THE EXIT!", 4.0f);
        }
        return;
    }
    setStatus("Nothing nearby responds. Check the room map and search each chamber.", 2.0f);
}

void keyDown(unsigned char k, int, int)
{
    k = static_cast<unsigned char>(std::tolower(k));
    const bool firstPress = !keyDownArr[k];
    keyDownArr[k] = true;
    if (!firstPress) return;

    if (k == 27 || k == 'q') std::exit(0);

    if (k == 'n') {
        masterVol = masterVol > 0.0f ? 0.0f : 1.0f;
        setStatus(masterVol > 0 ? "Sound ON." : "Sound OFF.", 1.5f);
        return;
    }

    if (k == 13) {
        if (state == INTRO) { beginPlaying(); setStatus("Find the objectives and survive.", 5.0f); }
        else if (state == MENU) { introLevel = 1; introTime = 0.0f; lastIntroScene = -1; state = INTRO; setMenuCamera(); }
        else if (state == WON) {
            introLevel = currentLevel + 1; introTime = 0.0f; lastIntroScene = -1;
            currentLevel = 1;                      // draw the mansion during the cinematic
            state = INTRO; setMenuCamera();
        }
        else if (state == GAME_COMPLETE) { resetGame(); introLevel = 1; state = MENU; setMenuCamera(); }
        else if (state == LOST) { restartCurrentLevel(); state = PLAYING; }
        return;
    }

    if (k == 'p') {
        if (state == PLAYING) state = PAUSED;
        else if (state == PAUSED) state = PLAYING;
        return;
    }
    if (state != PLAYING) return;

    if (k == 'f') {
        if (battery <= 0.0f) setStatus("No battery left...", 2.0f);
        else {
            flashlight = !flashlight;
            if (!flashlight) uvMode = false;
            sfx(S_CLICK, 0.6f);
            setStatus(flashlight ? "Flashlight ON." : "Flashlight OFF. The darkness creeps in...", 2.0f);
        }
    }
    else if (k == 'u') {
        if (!lightActive()) setStatus("Turn on the flashlight and keep some battery for UV scanning.", 3.0f);
        else {
            uvMode = !uvMode;
            sfx(S_CLICK, 0.6f);
            setStatus(uvMode ? "UV scanner active. Search for glowing spectral markings." : "UV scanner off.", 3.0f);
        }
    }
    else if (currentLevel >= 2 && k >= '1' && k <= '4' &&
        nearChapterPoint(-7.0f, -5.0f, 2.5f) && !chapterPuzzle[1]) {
        if (!uvMode) setStatus("The numbers are invisible. Activate UV mode (U) first.", 2.5f);
        else {
            const int code[3] = { 3, 1, 4 };
            if (libraryCodeStep < 0 || libraryCodeStep > 3) libraryCodeStep = 0;
            if (libraryCodeStep < 3 && (k - '0') == code[libraryCodeStep]) {
                ++libraryCodeStep;
                sfx(S_CHIME, 0.5f);
                if (libraryCodeStep >= 3) {
                    chapterPuzzle[1] = true;
                    ghosts[0].speed += 0.10f;
                    sfx(S_SLAM, 0.8f);
                    setStatus("LIBRARY TRIAL SOLVED: The books slam shut behind you!", 4.0f);
                }
                else {
                    char msg[100];
                    snprintf(msg, sizeof(msg), "Correct. %d of 3 book numbers entered...", libraryCodeStep);
                    setStatus(msg, 2.0f);
                }
            }
            else {
                libraryCodeStep = 0;
                sanity = std::max(0.0f, sanity - 7.0f);
                ghosts[0].speed += 0.08f;
                lightning = 0.8f;
                hurtFlash = 0.6f;
                setStatus("WRONG BOOK! The shelves move. Sequence reset (-7 sanity).", 3.0f);
            }
        }
    }
    else if (k == 'e') {
        if (currentLevel >= 2) { interactChapter2(); return; }
        const float dx = px, dz = pz - 5.0f;
        if (dx * dx + dz * dz < 4.0f) {
            if (doorOpen && std::fabs(dz) < 0.5f && std::fabs(dx) < 1.2f)
                setStatus("Step out of the doorway first.", 2.0f);
            else {
                doorOpen = !doorOpen;
                sfx(doorOpen ? S_CREAK : S_SLAM, doorOpen ? 0.7f : 0.8f, 0.0f);
                setStatus(doorOpen ? "The door creaks open..." : "The door slams shut.", 2.5f);
            }
        }
        else setStatus("Move closer to the front door to interact.", 2.0f);
    }
    else if (k == 'h') showHelp = !showHelp;
    else if (k == 'm') {
        if (currentLevel == 3) setStatus("There is no map in the Heart of Blackwood.", 2.0f);
        else showMap = !showMap;
    }
    else if (k == 'r') {
        restartCurrentLevel();
        setStatus("Chapter restarted.", 2.0f);
    }
}

void keyUp(unsigned char k, int, int) { keyDownArr[(unsigned char)std::tolower(k)] = false; }
void specialDown(int k, int, int) { if (k >= 0 && k < 256) arrows[k] = true; }
void specialUp(int k, int, int) { if (k >= 0 && k < 256) arrows[k] = false; }

