// =====================================================================
//  GAME LOGIC
// =====================================================================
bool overlaps(const AABB& b, float x, float z, float r)
{
    return x + r > b.x0 && x - r < b.x1 && z + r > b.z0 && z - r < b.z1;
}
bool blocked(float x, float z)
{
    const float r = 0.28f;
    if (currentLevel >= 2) {
        if (x < -11.55f || x > 11.55f || z > 5.95f || z < -35.8f) return true;
        for (size_t i = 0; i < chapter2Walls.size(); ++i)
            if (overlaps(chapter2Walls[i], x, z, r)) return true;
        return false;
    }
    if (x < -18 || x > 18 || z < -18 || z > 18) return true;
    for (size_t i = 0; i < walls.size(); i++) if (overlaps(walls[i], x, z, r)) return true;
    if (doorAngle > -70 && overlaps(DOOR_BOX, x, z, r)) return true;
    if (gateAngle < 60 && overlaps(GATE_BOX, x, z, r)) return true;
    return false;
}
bool insideHouse() { return currentLevel >= 2 || (px > -5 && px < 5 && pz > -5 && pz < 5); }

void updatePlayer(float dt)
{
    const LevelCfg& C = LV[currentLevel];
    float y = rad(yaw), fx = std::sin(y), fz = -std::cos(y), rx = std::cos(y), rz = std::sin(y);
    float mx = 0, mz = 0;
    if (keyDownArr['w']) { mx += fx; mz += fz; }
    if (keyDownArr['s']) { mx -= fx; mz -= fz; }
    if (keyDownArr['a']) { mx -= rx; mz -= rz; }
    if (keyDownArr['d']) { mx += rx; mz += rz; }
    float len = std::sqrt(mx * mx + mz * mz);
    bool moving = len > 0.01f;
    bool sprint = keyDownArr[' '] && stamina > 0 && moving;
    playerMoving = moving; playerSprint = sprint;

    if (moving) {
        float speed = sprint ? 6.5f : 3.6f;
        mx = mx / len * speed * dt; mz = mz / len * speed * dt;
        if (!blocked(px + mx, pz)) px += mx;
        if (!blocked(px, pz + mz)) pz += mz;
        bobPhase += dt * (sprint ? 14.0f : 9.0f);
    }
    py = 1.65f + (moving ? 0.045f * std::sin(bobPhase) : 0.0f);

    if (sprint) stamina = std::max(0.0f, stamina - 32 * dt);
    else stamina = std::min(100.0f, stamina + 16 * dt);

    if (arrows[GLUT_KEY_LEFT])  yaw -= 80 * dt;
    if (arrows[GLUT_KEY_RIGHT]) yaw += 80 * dt;
    if (arrows[GLUT_KEY_UP])    pitch += 60 * dt;
    if (arrows[GLUT_KEY_DOWN])  pitch -= 60 * dt;
    pitch = clampf(pitch, -75.0f, 75.0f);

    // Chapter III: the flashlight randomly cuts out
    if (blackout > 0) blackout -= dt;
    if (currentLevel == 3 && flashlight && battery > 0 && blackout <= 0) {
        blackoutTimer -= dt;
        if (blackoutTimer <= 0) {
            blackout = frand(1.6f, 2.8f);
            blackoutTimer = frand(14, 28);
            setStatus("THE LIGHT CUTS OUT!", 2.0f);
            sfx(S_CLICK, 0.7f);
            sfx(S_WHISPER, 0.5f, frand(-0.8f, 0.8f));
        }
    }

    bool light = lightActive();
    if (light) {
        float drainRate = (uvMode ? 2.0f : 1.1f) * C.battMul;
        battery = std::max(0.0f, battery - drainRate * dt);
        if (battery <= 0) {
            flashlight = false; uvMode = false;
            setStatus("Your flashlight died! Find a battery!", 4);
            sfx(S_CLICK, 0.8f);
        }
    }

    bool nearGhost = false;
    for (int i = 0; i < NGHOST; i++) if (ghosts[i].active) {
        float gx = ghosts[i].x - px, gz = ghosts[i].z - pz;
        if (gx * gx + gz * gz < 25) nearGhost = true;
    }
    bool drains = (currentLevel >= 2) || insideHouse();
    if (!light && drains) sanity -= C.darkDrain * dt;
    else if (nearGhost) sanity -= C.nearDrain * dt;
    else sanity = std::min(100.0f, sanity + C.regen * dt);
    sanity -= C.baseDrain * dt;

    for (size_t i = 0; i < items.size(); i++) {
        Item& it = items[i];
        if (it.taken) continue;
        float ix = it.x - px, iz = it.z - pz;
        if (ix * ix + iz * iz < 1.1f * 1.1f) {
            it.taken = true;
            sfx(S_CHIME, 0.7f, panFor(it.x, it.z));
            if (it.type == ITEM_KEY) {
                keyCount++;
                setStatus(it.note, 4.5f);
                if (keyCount == 3) { lightning = 1.0f; sfx(S_BELL, 0.7f); }
            }
            else {
                battery = std::min(100.0f, battery + it.amt);
                setStatus(it.note, 2.5f);
            }
        }
    }

    if (uvMode) {
        for (int i = 0; i < CLUE_COUNT; ++i) {
            if (clues[i].found || currentLevel != 1) continue;
            float cx = clues[i].x - px, cz = clues[i].z - pz;
            if (cx * cx + cz * cz < 2.0f * 2.0f) {
                clues[i].found = true;
                clueCount++;
                sfx(S_CHIME, 0.5f);
                setStatus(clues[i].message, 5.0f);
            }
        }
    }

    if (currentLevel == 1) {
        if (keyCount >= 3 && pz > 15.8f && std::fabs(px) < 2.0f) {
            state = WON;
            setStatus("The gate opens... but the darkness beneath the manor calls you.", 5.0f);
        }
    }
    else {
        const float sx[3] = { -7.0f, 7.0f, 0.0f };
        const float sz[3] = { -5.0f, -13.5f, -30.5f };
        for (int i = 0; i < 3; ++i) {
            if (sigilFound[i]) continue;
            float dx = px - sx[i], dz = pz - sz[i];
            if (dx * dx + dz * dz < 1.25f * 1.25f) {
                sigilFound[i] = true; corridorSigils++;
                for (int g = 0; g < NGHOST; g++) if (ghosts[g].type == 0) ghosts[g].speed += 0.12f;
                lightning = 0.8f;
                sfx(S_BELL, 0.9f);
                setStatus("SIGIL TAKEN. YOU HAVE MADE THEM ANGRIER.", 3.0f);
            }
        }
        const float tx[3] = { 7.0f, -7.0f, 0.0f };
        const float tz[3] = { -5.0f, -13.5f, -30.5f };
        for (int i = 0; i < 3; ++i) {
            float dx = px - tx[i], dz = pz - tz[i];
            if (!chapterTrapTriggered[i] && dx * dx + dz * dz < 1.15f * 1.15f) {
                chapterTrapTriggered[i] = true;
                sanity = std::max(0.0f, sanity - 9.0f);
                battery = std::max(0.0f, battery - 8.0f);
                hurtFlash = 0.85f;
                lightning = 1.0f;
                setStatus("A HIDDEN FLOOR SIGIL EXPLODES! -9 SANITY, -8 BATTERY!", 3.0f);
            }
        }
        if (ritualReleased && pz < -33.0f && std::fabs(px) < 2.2f) {
            if (currentLevel == 2) {
                state = WON;
                setStatus("The Forgotten Wing is behind you... but the heart of Blackwood still beats.", 5.0f);
            }
            else state = GAME_COMPLETE;
        }
    }

    if (C.timeLimit > 0 && playTime >= C.timeLimit) {
        loseReason = "THE HOUSE HAS SEALED ITSELF FOREVER...";
        sanity = 0;
    }
    if (sanity <= 0) {
        sanity = 0;
        if (state == PLAYING) {
            if (C.timeLimit <= 0 || playTime < C.timeLimit) loseReason = "YOUR MIND HAS SHATTERED...";
            state = LOST;
        }
    }
}

void hitGhost(Ghost& g, int gi, const LevelCfg& C)
{
    sanity = std::max(0.0f, sanity - C.dmg);
    hurtFlash = 1.0f;
    g.hitCooldown = C.hitCD;
    g.alpha = 0.95f;
    if (g.type == 1) {
        g.x = frand(-6, 6); g.z = std::max(-34.0f, std::min(4.5f, pz - 14.0f));
    }
    else {
        g.z = std::max(-34.0f, std::min(4.5f, pz + (gi == 0 ? -8.0f : 5.0f)));
        g.x = (gi == 0 ? 7.0f : -7.0f);
    }
    char msg[80];
    snprintf(msg, sizeof(msg), "A HAND GRABS YOU! (-%d SANITY) RUN!!", (int)C.dmg);
    setStatus(msg, 2.5f);
}

void updateGhosts(float dt)
{
    const LevelCfg& C = LV[currentLevel];
    const float yr = rad(yaw);
    const float vfx = std::sin(yr), vfz = -std::cos(yr);
    const bool lightOn = lightActive();

    for (int gi = 0; gi < NGHOST; ++gi) {
        Ghost& g = ghosts[gi];
        if (!g.active) continue;

        float dx = px - g.x, dz = pz - g.z;
        float d = std::sqrt(dx * dx + dz * dz) + 0.0001f;
        const float c = (-dx * vfx - dz * vfz) / d;       // 1 = dead ahead
        g.hitCooldown -= dt;

        // ---- the watcher: frozen while you look at it, fast when you don't ----
        if (g.type == 1) {
            bool seen = c > 0.45f && d < 18.0f;
            if (seen && lightOn && c > 0.9f && d < 9.0f) {
                g.x -= dx / d * 1.3f * dt; g.z -= dz / d * 1.3f * dt;     // light drives it back
                g.alpha = std::max(0.4f, g.alpha - 0.5f * dt);
            }
            else if (!seen) {
                float sp = 2.3f + corridorSigils * 0.25f;
                g.x += dx / d * sp * dt; g.z += dz / d * sp * dt;
                g.alpha = std::min(0.9f, g.alpha + 0.8f * dt);
            }
            g.x = clampf(g.x, -10.7f, 10.7f);
            g.z = clampf(g.z, -34.5f, 5.0f);
            if (d < 0.95f && g.hitCooldown <= 0.0f) hitGhost(g, gi, C);
            continue;
        }

        // ---- Chapters II & III: two relentless hunters ----
        if (currentLevel >= 2) {
            if (lightOn && d < C.stunRange && c > C.stunCos && g.stun <= 0.0f) {
                g.stun = C.stunTime;
                battery = std::max(0.0f, battery - 4.0f * dt);
                setStatus("IT IS STILL COMING. KEEP MOVING!", 1.0f);
            }
            if (g.stun > 0.0f) {
                g.stun -= dt;
                g.x -= dx / d * 1.7f * dt; g.z -= dz / d * 1.7f * dt;
                g.alpha = std::max(0.28f, g.alpha - 0.55f * dt);
            }
            else {
                g.alpha = std::min(0.96f, g.alpha + 0.55f * dt);
                float base = d < 4.5f ? 1.55f : (d < 9.0f ? 1.12f : 0.72f);
                float sp = base * g.speed * C.chaseMul * 1.05f + corridorSigils * 0.12f;
                g.x += dx / d * sp * dt; g.z += dz / d * sp * dt;
            }
            g.x = clampf(g.x, -10.7f, 10.7f);
            g.z = clampf(g.z, -34.5f, 5.0f);
            if (d < 0.92f && g.hitCooldown <= 0.0f && g.stun <= 0.0f) hitGhost(g, gi, C);
            continue;
        }

        // ---- Chapter I: a patrolling ghost, repelled by the flashlight ----
        if (g.alpha < 0.7f && g.stun <= 0.0f) g.alpha = std::min(0.7f, g.alpha + 0.4f * dt);
        if (lightOn && d < C.stunRange && c > C.stunCos) {
            if (g.stun <= 0.0f) setStatus("The light burns it! The ghost recoils!", 1.5f);
            g.stun = C.stunTime;
            battery = std::max(0.0f, battery - 3.0f * dt);
        }
        const bool playerSafe = pz > 13.5f;
        if (g.stun > 0.0f) {
            g.stun -= dt;
            g.x -= dx / d * 1.6f * dt; g.z -= dz / d * 1.6f * dt;
            g.alpha = std::max(0.18f, g.alpha - 1.0f * dt);
        }
        else if (d < 6.5f && !playerSafe) {
            const float sp = g.speed * (1.0f + 0.06f * keyCount);
            g.x += dx / d * sp * dt; g.z += dz / d * sp * dt;
        }
        else {
            const float wx = WAYPOINTS[g.wp][0] - g.x, wz = WAYPOINTS[g.wp][1] - g.z;
            const float wd = std::sqrt(wx * wx + wz * wz) + 0.0001f;
            if (wd < 0.4f) g.wp = rand() % WP_COUNT;
            else { g.x += wx / wd * g.speed * 0.6f * dt; g.z += wz / wd * g.speed * 0.6f * dt; }
        }
        g.x = clampf(g.x, -8.0f, 8.0f);
        g.z = clampf(g.z, -6.0f, 12.5f);

        if (d < 0.70f && g.hitCooldown <= 0.0f && g.stun <= 0.0f) {
            sanity = std::max(0.0f, sanity - C.dmg);
            hurtFlash = 1.0f;
            g.hitCooldown = C.hitCD;
            g.alpha = 0.0f;
            int farWp = 0; float best = -1.0f;
            for (int w = 0; w < WP_COUNT; ++w) {
                const float ax = WAYPOINTS[w][0] - px, az = WAYPOINTS[w][1] - pz;
                if (ax * ax + az * az > best) { best = ax * ax + az * az; farWp = w; }
            }
            g.x = WAYPOINTS[farWp][0]; g.z = WAYPOINTS[farWp][1];
            g.wp = rand() % WP_COUNT;
            setStatus("The spirit brushes past you! (-14 sanity)", 3.0f);
        }
    }
}

void playIntroSound(int scene)
{
    switch (scene) {
    case 0: sfx(S_BELL, 0.6f); break;
    case 1: lightning = 1.0f; break;
    case 2: sfx(S_WHISPER, 0.7f, -0.7f); sfx(S_SCARE, 0.5f); break;
    case 3: sfx(S_SLAM, 0.8f); break;
    case 4: sfx(S_CREAK, 0.6f, 0.5f); sfx(S_WHISPER, 0.6f, 0.7f); sfx(S_SCARE, 0.5f); break;
    default: sfx(S_MOAN, 0.5f); sfx(S_HEART, 0.7f); break;
    }
}

void updateIntroCamera(int scene)
{
    if (scene == 0) { px = 2.5f; py = 1.65f; pz = 14.2f; yaw = -8.0f + 4.0f * std::sin(timeSec * 0.15f); pitch = 18.0f + 3.0f * std::sin(timeSec * 0.10f); }
    else if (scene == 1) { px = -6.5f; py = 1.9f; pz = 10.5f; yaw = 25.0f + 5.0f * std::sin(timeSec * 0.20f); pitch = 8.0f + 2.0f * std::sin(timeSec * 0.13f); }
    else if (scene == 2) { px = 0.0f; py = 1.7f; pz = 8.0f; yaw = 2.0f * std::sin(timeSec * 0.25f); pitch = 5.0f + 2.0f * std::sin(timeSec * 0.18f); }
    else if (scene == 3) { px = 0.0f; py = 1.65f; pz = 5.7f; yaw = 8.0f * std::sin(timeSec * 0.30f); pitch = 3.0f + 3.0f * std::sin(timeSec * 0.22f); }
    else if (scene == 4) { px = -2.7f; py = 2.0f; pz = 1.8f; yaw = -25.0f + 10.0f * std::sin(timeSec * 0.25f); pitch = 7.0f + 2.0f * std::sin(timeSec * 0.20f); }
    else { px = 0.0f; py = 1.65f; pz = 5.8f; yaw = 8.0f * std::sin(timeSec * 0.30f); pitch = 3.0f + 3.0f * std::sin(timeSec * 0.22f); }
}

void beginPlaying()
{
    lastIntroScene = -1;
    if (introLevel == 1) resetGame();
    else if (introLevel == 2) startLevel2();
    else startLevel3();
    state = PLAYING;
}

void update(int)
{
    int now = glutGet(GLUT_ELAPSED_TIME);
    float dt = (now - lastTime) / 1000.0f; lastTime = now; if (dt > 0.05f) dt = 0.05f;
    timeSec = now / 1000.0f;

    // lights flicker harder in later chapters
    flicker = clampf(0.60f + 0.28f * std::sin(now * 0.017f) + 0.12f * std::sin(now * 0.071f), 0.15f, 1.0f);
    int blackoutEvery = currentLevel == 3 ? 4 : (currentLevel == 2 ? 6 : 9);
    if ((now / 1000) % blackoutEvery == 0 && std::sin(now * 0.05f) > 0.95f) flicker = 0.1f;
    nextLightning -= dt;
    if (nextLightning <= 0) { lightning = 1.0f; nextLightning = frand(6, 15); }
    if (lightning > 0) {
        lightning -= dt * 2.5f;
        if (lightning < 0.35f && lightning > 0.3f && rand() % 2) lightning = 0.8f;
        if (lightning < 0) lightning = 0;
    }
    hurtFlash = std::max(0.0f, hurtFlash - dt * 1.2f);
    statusTimer -= dt;

    float shake = hurtFlash * 0.08f;
    shakeX = frand(-shake, shake); shakeY = frand(-shake, shake);

    float insideTarget = insideHouse() ? 1.0f : 0.0f;
    insideFactor += (insideTarget - insideFactor) * std::min(1.0f, dt * 2.0f);

    if (state == PLAYING) {
        playTime += dt;
        updatePlayer(dt);
        if (state == PLAYING) updateGhosts(dt);
    }
    if (state == MENU) {
        yaw = -8.0f + 10.0f * std::sin(timeSec * 0.15f);
        pitch = 20.0f + 3.0f * std::sin(timeSec * 0.1f);
    }
    else if (state == INTRO) {
        introTime += dt;
        int scene = std::min(5, static_cast<int>(introTime / 6.0f));
        updateIntroCamera(scene);
        if (scene != lastIntroScene) { lastIntroScene = scene; playIntroSound(scene); }
        if (introTime >= 36.0f) {
            beginPlaying();
            setStatus("Survive.", 5.0f);
        }
    }

    float target = doorOpen ? -95.0f : 0.0f;
    if (doorAngle < target) doorAngle = std::min(target, doorAngle + 120 * dt);
    if (doorAngle > target) doorAngle = std::max(target, doorAngle - 120 * dt);
    float gTarget = keyCount >= 3 ? 100.0f : 0.0f;
    if (gateAngle < gTarget) gateAngle = std::min(gTarget, gateAngle + 50 * dt);
    if (gateAngle > gTarget) gateAngle = std::max(gTarget, gateAngle - 200 * dt);

    soundUpdate(dt);
    audioPump();

    glutPostRedisplay(); glutTimerFunc(16, update, 0);
}

