#else
FILE* apipe = NULL; int afd = -1; double audioCarry = 0; int lastAudioMs = 0;
bool audioOpen()
{
    signal(SIGPIPE, SIG_IGN);
    apipe = popen("aplay -q -t raw -f S16_LE -c 2 -r 22050 2>/dev/null || "
        "paplay --raw --format=s16le --rate=22050 --channels=2 2>/dev/null", "w");
    if (!apipe) return false;
    afd = fileno(apipe);
    fcntl(afd, F_SETFL, fcntl(afd, F_GETFL) | O_NONBLOCK);
    lastAudioMs = glutGet(GLUT_ELAPSED_TIME);
    return true;
}
void audioPump()
{
    if (!apipe) return;
    int now = glutGet(GLUT_ELAPSED_TIME);
    double fr = (now - lastAudioMs) * SR / 1000.0 + audioCarry;
    lastAudioMs = now;
    int n = (int)fr; audioCarry = fr - n;
    if (n > 2048) n = 2048;
    if (n <= 0) return;
    static short tmp[4096 * 2];
    mixFrames(tmp, n);
    ssize_t w = write(afd, tmp, (size_t)n * 4); (void)w;
}
void audioClose() { if (apipe) { pclose(apipe); apipe = NULL; } }
