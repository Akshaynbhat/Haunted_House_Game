void audioInit()
{
    memset(voices, 0, sizeof(voices));
    buildSounds();
    audioOK = audioOpen();
    if (!audioOK) std::printf("[audio] no sound device available - running silent.\n");
}

// ---- sound director: ambience, heartbeat, whispers, moans, footsteps ----
float stepTimer = 0, whisperTimer = 8, creakTimer = 20, heartTimer = 0, thunderDelay = -1;
float moanTimer[NGHOST] = { 0, 0, 0 };
float prevLightning = 0, prevHurt = 0;
int audioLevel = 0, prevState = -1;

float nearestGhostDist()
{
    float best = 999;
    for (int i = 0; i < NGHOST; i++) if (ghosts[i].active) {
        float dx = ghosts[i].x - px, dz = ghosts[i].z - pz;
        best = std::min(best, std::sqrt(dx * dx + dz * dz));
    }
    return best;
}

void soundUpdate(float dt)
{
    if (!audioOK) return;
    int lvl = (state == INTRO) ? introLevel : currentLevel;
    if (lvl < 1) lvl = 1;
    if (lvl != audioLevel) {
        audioLevel = lvl;
        if (voiceDrone >= 0) voices[voiceDrone].active = false;
        voiceDrone = playSnd(S_DRONE1 + lvl - 1, 0.0f, 0.0f, true);
    }
    if (voiceWind < 0 || !voices[voiceWind].active) voiceWind = playSnd(S_WIND, 0.0f, 0.0f, true);

    bool paused = state == PAUSED;
    bool ended = state == WON || state == LOST || state == GAME_COMPLETE;
    float dv = paused ? 0.05f : (ended ? 0.08f : 0.20f + 0.07f * lvl);
    float wv = lvl == 1 ? 0.10f + 0.40f * (1.0f - insideFactor) : 0.10f + 0.06f * lvl;
    if (paused) wv *= 0.3f;
    if (voiceDrone >= 0) voices[voiceDrone].vol = dv;
    if (voiceWind >= 0) voices[voiceWind].vol = wv;

    // lightning -> delayed thunder (works for every lightning source)
    if (lightning > prevLightning + 0.5f) thunderDelay = frand(0.25f, 1.8f);
    prevLightning = lightning;
    if (thunderDelay >= 0) {
        thunderDelay -= dt;
        if (thunderDelay < 0) { playSnd(S_THUNDER, 0.55f + 0.3f * (1.0f - insideFactor), frand(-0.4f, 0.4f)); thunderDelay = -1; }
    }
    // hit sting
    if (hurtFlash > prevHurt + 0.4f) playSnd(S_SCARE, 0.85f, 0.0f);
    prevHurt = hurtFlash;
    // win / lose stings
    if ((int)state != prevState) {
        if (state == WON || state == GAME_COMPLETE) playSnd(S_WIN, 0.8f);
        if (state == LOST) playSnd(S_LOSE, 0.9f);
        prevState = (int)state;
    }
    if (state != PLAYING) return;

    // heartbeat grows with fear
    float fear = clampf((60.0f - sanity) / 60.0f, 0.0f, 1.0f);
    float ghostNear = clampf((8.0f - nearestGhostDist()) / 8.0f, 0.0f, 1.0f);
    float threat = std::max(fear, ghostNear);
    if (threat > 0.15f) {
        heartTimer -= dt;
        if (heartTimer <= 0) {
            playSnd(S_HEART, 0.35f + 0.55f * threat);
            heartTimer = 1.25f - 0.75f * threat;
        }
    }
    // random whispers (more frequent each chapter)
    whisperTimer -= dt;
    if (whisperTimer <= 0) {
        playSnd(S_WHISPER, 0.22f + 0.1f * lvl, frand(-0.9f, 0.9f));
        const float lo[4] = { 0, 14, 8, 4 }, hi[4] = { 0, 26, 15, 9 };
        whisperTimer = frand(lo[lvl], hi[lvl]);
    }
    // door / floorboard creaks
    creakTimer -= dt;
    if (creakTimer <= 0) {
        if (lvl > 1 || insideFactor > 0.5f) playSnd(S_CREAK, 0.35f, frand(-0.8f, 0.8f));
        const float lo[4] = { 0, 25, 15, 9 }, hi[4] = { 0, 40, 25, 18 };
        creakTimer = frand(lo[lvl], hi[lvl]);
    }
    // ghost moans, louder and closer as they approach
    for (int i = 0; i < NGHOST; i++) {
        if (!ghosts[i].active) continue;
        float dx = ghosts[i].x - px, dz = ghosts[i].z - pz, d = std::sqrt(dx * dx + dz * dz);
        if (d > 10.0f) continue;
        moanTimer[i] -= dt;
        if (moanTimer[i] <= 0) {
            playSnd(S_MOAN, (1.0f - d / 10.0f) * (0.5f + 0.12f * lvl), panFor(ghosts[i].x, ghosts[i].z));
            moanTimer[i] = frand(2.6f, 4.2f) - 0.4f * lvl;
        }
    }
    // footsteps
    if (playerMoving) {
        stepTimer -= dt;
        if (stepTimer <= 0) {
            playSnd(S_STEP, playerSprint ? 0.35f : 0.2f, 0.0f);
            stepTimer = playerSprint ? 0.30f : 0.48f;
        }
    }
    else stepTimer = 0;
}

