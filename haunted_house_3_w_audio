const int SR = 22050;
enum Snd {
    S_DRONE1, S_DRONE2, S_DRONE3, S_WIND, S_HEART, S_THUNDER, S_CREAK, S_WHISPER,
    S_MOAN, S_SCARE, S_CHIME, S_BELL, S_SLAM, S_STEP, S_CLICK, S_WIN, S_LOSE, S_COUNT
};
std::vector<float> sndBuf[S_COUNT];

unsigned int rngState = 12345u;
float nrand()
{
    rngState = rngState * 1664525u + 1013904223u;
    return ((rngState >> 8) & 0xFFFF) / 32768.0f - 1.0f;
}
std::vector<float> mk(float sec) { return std::vector<float>((size_t)(sec * SR), 0.0f); }
void normalizeBuf(std::vector<float>& v, float peak)
{
    float m = 0.0001f;
    for (size_t i = 0; i < v.size(); i++) m = std::max(m, std::fabs(v[i]));
    for (size_t i = 0; i < v.size(); i++) v[i] *= peak / m;
}
void addEcho(std::vector<float>& v, float delaySec, float gain)
{
    size_t d = (size_t)(delaySec * SR);
    for (size_t i = v.size(); i-- > d; ) v[i] += v[i - d] * gain;
}

// Looping dark drone, a different chord for each chapter.
std::vector<float> genDrone(int lvl)
{
    std::vector<float> v = mk(4.0f);
    float f[4], a[4]; int n;
    if (lvl == 1) { f[0] = 55.0f; f[1] = 82.5f; f[2] = 110.0f; a[0] = 0.5f; a[1] = 0.3f; a[2] = 0.2f; n = 3; }
    else if (lvl == 2) { f[0] = 55.0f; f[1] = 58.25f; f[2] = 116.25f; f[3] = 164.5f; a[0] = 0.5f; a[1] = 0.45f; a[2] = 0.25f; a[3] = 0.12f; n = 4; }
    else { f[0] = 41.25f; f[1] = 58.25f; f[2] = 43.5f; f[3] = 880.0f; a[0] = 0.55f; a[1] = 0.4f; a[2] = 0.4f; a[3] = 0.05f; n = 4; }
    float mod = lvl == 1 ? 0.15f : (lvl == 2 ? 0.3f : 0.5f);
    for (size_t i = 0; i < v.size(); i++) {
        float t = (float)i / SR, s = 0;
        for (int k = 0; k < n; k++)
            s += a[k] * (std::sin(2 * PI * f[k] * t) + 0.5f * std::sin(4 * PI * f[k] * t));
        float am = 1.0f + mod * std::sin(2 * PI * t / 4.0f);
        if (lvl == 3) am *= 0.75f + 0.25f * std::sin(2 * PI * 1.0f * t);   // 60 bpm pulse
        v[i] = s * am;
    }
    normalizeBuf(v, 0.9f);
    return v;
}
std::vector<float> genWind()
{
    std::vector<float> v = mk(6.0f);
    float lp1 = 0, lp2 = 0;
    for (size_t i = 0; i < v.size(); i++) {
        float n = nrand(), g = std::sin(PI * (float)i / v.size());
        lp1 += (n - lp1) * 0.06f; lp2 += (n - lp2) * 0.01f;
        v[i] = ((lp1 - lp2) * 2.2f + lp2) * g * g;
    }
    normalizeBuf(v, 0.9f);
    return v;
}
std::vector<float> genHeart()
{
    std::vector<float> v = mk(1.0f);
    const float t0[2] = { 0.0f, 0.3f }, amp[2] = { 1.0f, 0.7f };
    for (size_t i = 0; i < v.size(); i++) {
        float t = (float)i / SR, s = 0;
        for (int k = 0; k < 2; k++) if (t >= t0[k]) {
            float x = t - t0[k];
            s += amp[k] * std::sin(2 * PI * (48 + 30 * std::exp(-x * 30)) * x) * std::exp(-x * 14);
        }
        v[i] = s;
    }
    normalizeBuf(v, 0.95f);
    return v;
}
std::vector<float> genThunder()
{
    std::vector<float> v = mk(4.0f);
    float lp = 0, lp2 = 0;
    for (size_t i = 0; i < v.size(); i++) {
        float t = (float)i / SR, n = nrand();
        lp += (n - lp) * 0.04f; lp2 += (n - lp2) * 0.3f;
        float env = t < 0.05f ? t / 0.05f : std::exp(-(t - 0.05f) * 0.9f);
        float rumble = lp * env * (0.7f + 0.3f * std::sin(2 * PI * 7 * t));
        float crack = (n - lp2) * std::exp(-t * 20) * 0.6f;
        v[i] = rumble * 4.0f + crack;
    }
    normalizeBuf(v, 0.95f);
    return v;
}
std::vector<float> genCreak()
{
    std::vector<float> v = mk(1.5f);
    float ph = 0, lp = 0;
    for (size_t i = 0; i < v.size(); i++) {
        float t = (float)i / SR;
        float f = 140 + 90 * std::sin(2 * PI * 2.1f * t) + 60 * t;
        ph += 2 * PI * f / SR; if (ph > 2 * PI) ph -= 2 * PI;
        float saw = ph / PI - 1.0f;
        lp += (saw + 0.2f * nrand() - lp) * 0.25f;
        v[i] = lp * std::sin(PI * t / 1.5f) * (0.7f + 0.3f * std::sin(2 * PI * 9 * t));
    }
    normalizeBuf(v, 0.9f);
    return v;
}
std::vector<float> genWhisper()
{
    std::vector<float> v = mk(2.0f);
    float a = 0, b = 0;
    for (size_t i = 0; i < v.size(); i++) {
        float t = (float)i / SR, n = nrand();
        a += (n - a) * 0.55f; b += (n - b) * 0.12f;
        float syl = std::sin(2 * PI * 3.1f * t); syl = syl > 0 ? syl * syl : 0;
        v[i] = (a - b) * syl * std::sin(PI * t / 2.0f);
    }
    addEcho(v, 0.17f, 0.45f); addEcho(v, 0.34f, 0.25f);
    normalizeBuf(v, 0.9f);
    return v;
}
std::vector<float> genMoan()
{
    std::vector<float> v = mk(2.4f);
    float ph = 0, lp = 0;
    for (size_t i = 0; i < v.size(); i++) {
        float t = (float)i / SR;
        float f = 200 * std::exp(-0.25f * t) + 7 * std::sin(2 * PI * 5.2f * t);
        ph += 2 * PI * f / SR;
        float s = std::sin(ph) + 0.5f * std::sin(2 * ph) + 0.3f * std::sin(3 * ph);
        lp += (nrand() - lp) * 0.2f;
        v[i] = (s + 0.5f * lp) * std::pow(std::max(0.0f, std::sin(PI * t / 2.4f)), 0.8f);
    }
    addEcho(v, 0.25f, 0.3f);
    normalizeBuf(v, 0.9f);
    return v;
}
std::vector<float> genScare()
{
    std::vector<float> v = mk(1.0f);
    float lp = 0, ph = 0;
    for (size_t i = 0; i < v.size(); i++) {
        float t = (float)i / SR, n = nrand();
        lp += (n - lp) * 0.3f;
        ph += 2 * PI * (400 + 1200 * t) / SR;
        v[i] = (n - lp) * std::exp(-t * 4) + 0.5f * (std::sin(2 * PI * 233 * t) + std::sin(2 * PI * 247 * t)) * std::exp(-t * 3)
            + 0.4f * std::sin(ph) * std::exp(-t * 5);
    }
    normalizeBuf(v, 0.95f);
    return v;
}
std::vector<float> genBell(float freq, float sec, float decay)
{
    std::vector<float> v = mk(sec);
    const float r[4] = { 1.0f, 2.01f, 2.76f, 4.07f }, am[4] = { 1.0f, 0.6f, 0.4f, 0.2f };
    for (size_t i = 0; i < v.size(); i++) {
        float t = (float)i / SR, s = 0;
        for (int k = 0; k < 4; k++) s += am[k] * std::sin(2 * PI * freq * r[k] * t) * std::exp(-t * (decay + 0.5f * k));
        v[i] = s;
    }
    normalizeBuf(v, 0.9f);
    return v;
}
std::vector<float> genSlam()
{
    std::vector<float> v = mk(1.4f);
    float lp = 0;
    for (size_t i = 0; i < v.size(); i++) {
        float t = (float)i / SR;
        lp += (nrand() - lp) * 0.1f;
        v[i] = std::sin(2 * PI * 60 * t) * std::exp(-t * 7) + 0.8f * lp * std::exp(-t * 10) + 0.2f * lp * std::exp(-t * 2.5f);
    }
    normalizeBuf(v, 0.95f);
    return v;
}
std::vector<float> genStep()
{
    std::vector<float> v = mk(0.2f);
    float lp = 0;
    for (size_t i = 0; i < v.size(); i++) {
        float t = (float)i / SR;
        lp += (nrand() - lp) * 0.1f;
        v[i] = (lp * 0.8f + 0.5f * std::sin(2 * PI * 80 * t)) * std::exp(-t * 30);
    }
    normalizeBuf(v, 0.9f);
    return v;
}
std::vector<float> genClick()
{
    std::vector<float> v = mk(0.05f);
    for (size_t i = 0; i < v.size(); i++) v[i] = nrand() * std::exp(-(float)i / SR * 120);
    normalizeBuf(v, 0.8f);
    return v;
}
std::vector<float> genWin()
{
    std::vector<float> v = mk(3.2f);
    const float notes[5] = { 523.25f, 659.25f, 783.99f, 1046.5f, 1318.5f };
    for (size_t i = 0; i < v.size(); i++) {
        float t = (float)i / SR, s = 0;
        for (int k = 0; k < 5; k++) if (t >= 0.3f * k) {
            float x = t - 0.3f * k;
            s += std::sin(2 * PI * notes[k] * x) * std::exp(-x * 2.2f) + 0.3f * std::sin(4 * PI * notes[k] * x) * std::exp(-x * 4);
        }
        v[i] = s;
    }
    normalizeBuf(v, 0.85f);
    return v;
}
std::vector<float> genLose()
{
    std::vector<float> v = mk(3.2f);
    float lp = 0;
    for (size_t i = 0; i < v.size(); i++) {
        float t = (float)i / SR;
        lp += (nrand() - lp) * 0.05f;
        float env = std::exp(-t * 0.8f);
        v[i] = (std::sin(2 * PI * 55 * t) + std::sin(2 * PI * 58.3f * t) + std::sin(2 * PI * 77.8f * t * (1 - 0.1f * t))) * env
            + 2.0f * lp * std::exp(-t * 1.5f);
    }
    normalizeBuf(v, 0.9f);
    return v;
}

void buildSounds()
{
    sndBuf[S_DRONE1] = genDrone(1); sndBuf[S_DRONE2] = genDrone(2); sndBuf[S_DRONE3] = genDrone(3);
    sndBuf[S_WIND] = genWind();     sndBuf[S_HEART] = genHeart();   sndBuf[S_THUNDER] = genThunder();
    sndBuf[S_CREAK] = genCreak();   sndBuf[S_WHISPER] = genWhisper(); sndBuf[S_MOAN] = genMoan();
    sndBuf[S_SCARE] = genScare();   sndBuf[S_CHIME] = genBell(659.25f, 2.0f, 3.0f);
    sndBuf[S_BELL] = genBell(196.0f, 4.0f, 0.9f);
    sndBuf[S_SLAM] = genSlam();     sndBuf[S_STEP] = genStep();     sndBuf[S_CLICK] = genClick();
    sndBuf[S_WIN] = genWin();       sndBuf[S_LOSE] = genLose();
}

// ---- mixer ----
struct Voice { int id; int pos; float vol, cur, pl, pr; bool loop, active; };
const int NVOICE = 24;
Voice voices[NVOICE];
int voiceDrone = -1, voiceWind = -1;
float masterVol = 1.0f;
bool audioOK = false;

int playSnd(int id, float vol, float pan = 0.0f, bool loop = false)
{
    int slot = -1;
    for (int i = 0; i < NVOICE; i++) if (!voices[i].active) { slot = i; break; }
    if (slot < 0) for (int i = 0; i < NVOICE; i++) if (!voices[i].loop) { slot = i; break; }
    if (slot < 0) return -1;
    pan = clampf(pan, -1.0f, 1.0f);
    Voice& v = voices[slot];
    v.id = id; v.pos = 0; v.vol = vol; v.cur = loop ? 0.0f : vol;
    v.pl = std::sqrt((1.0f - pan) * 0.5f); v.pr = std::sqrt((1.0f + pan) * 0.5f);
    v.loop = loop; v.active = true;
    return slot;
}
float panFor(float x, float z)
{
    float dx = x - px, dz = z - pz, d = std::sqrt(dx * dx + dz * dz) + 0.001f;
    float yr = rad(yaw);
    return clampf((dx * std::cos(yr) + dz * std::sin(yr)) / d, -1.0f, 1.0f);
}

void mixFrames(short* out, int frames)
{
    for (int f = 0; f < frames; f++) {
        float L = 0, R = 0;
        for (int i = 0; i < NVOICE; i++) {
            Voice& v = voices[i];
            if (!v.active) continue;
            const std::vector<float>& b = sndBuf[v.id];
            v.cur += (v.vol - v.cur) * 0.0008f;
            float s = b[v.pos] * v.cur;
            L += s * v.pl; R += s * v.pr;
            if (++v.pos >= (int)b.size()) { if (v.loop) v.pos = 0; else v.active = false; }
        }
        L *= masterVol * 1.5f; R *= masterVol * 1.5f;
        L = L / (1.0f + std::fabs(L)); R = R / (1.0f + std::fabs(R));     // soft clip
        out[f * 2] = (short)(L * 30000); out[f * 2 + 1] = (short)(R * 30000);
    }
}

#if defined(_WIN32)
const int AUDIO_BUFS = 6, AUDIO_FRAMES = 512;
HWAVEOUT hwo = NULL;
WAVEHDR whdr[AUDIO_BUFS];
short wbuf[AUDIO_BUFS][AUDIO_FRAMES * 2];
bool audioOpen()
{
    WAVEFORMATEX wf; memset(&wf, 0, sizeof(wf));
    wf.wFormatTag = WAVE_FORMAT_PCM; wf.nChannels = 2; wf.nSamplesPerSec = SR;
    wf.wBitsPerSample = 16; wf.nBlockAlign = 4; wf.nAvgBytesPerSec = SR * 4;
    if (waveOutOpen(&hwo, WAVE_MAPPER, &wf, 0, 0, CALLBACK_NULL) != MMSYSERR_NOERROR) return false;
    for (int i = 0; i < AUDIO_BUFS; i++) {
        memset(&whdr[i], 0, sizeof(WAVEHDR));
        whdr[i].lpData = (LPSTR)wbuf[i]; whdr[i].dwBufferLength = AUDIO_FRAMES * 4;
        waveOutPrepareHeader(hwo, &whdr[i], sizeof(WAVEHDR));
        whdr[i].dwFlags |= WHDR_DONE;
    }
    return true;
}
void audioPump()
{
    if (!hwo) return;
    for (int i = 0; i < AUDIO_BUFS; i++)
        if (whdr[i].dwFlags & WHDR_DONE) {
            mixFrames(wbuf[i], AUDIO_FRAMES);
            waveOutWrite(hwo, &whdr[i], sizeof(WAVEHDR));
        }
}
void audioClose()
{
    if (!hwo) return;
    waveOutReset(hwo);
    for (int i = 0; i < AUDIO_BUFS; i++) waveOutUnprepareHeader(hwo, &whdr[i], sizeof(WAVEHDR));
    waveOutClose(hwo); hwo = NULL;
}
