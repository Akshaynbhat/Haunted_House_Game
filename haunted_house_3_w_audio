void drawSpectralClues()
{
    if (!uvMode) return;
    glDisable(GL_LIGHTING);
    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA, GL_ONE);
    glDepthMask(GL_FALSE);
    for (int i = 0; i < CLUE_COUNT; ++i) {
        if (clues[i].found) continue;
        float pulse = 0.65f + 0.25f * std::sin(timeSec * 4.0f + i);
        glColor4f(0.35f, 0.85f, 1.0f, pulse);
        glPushMatrix();
