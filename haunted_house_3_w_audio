void drawGhost(const Ghost& g)
{
    if (!g.active || g.alpha <= 0.01f) return;
    float facing = std::atan2(px - g.x, pz - g.z) * 180.0f / PI;
    float sway = std::sin(timeSec * 1.7f + g.x) * 0.07f;
    float drift = std::sin(timeSec * 2.3f + g.z) * 0.10f;
    bool angry = g.stun <= 0;
    bool watcher = g.type == 1;

    glDisable(GL_LIGHTING);
    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
    glDepthMask(GL_FALSE);

    glColor4f(0.0f, 0.0f, 0.0f, 0.42f * g.alpha);
